---
import type { Locale } from '../../i18n/index';
import { getLocalizedField } from '../../i18n/content';
import { renderMarkdoc } from '../../lib/markdoc';
import OptimizedImage from '../OptimizedImage.astro';

interface Props {
  data: Record<string, unknown>;
  locale: Locale;
}

const { data, locale } = Astro.props;

const title = getLocalizedField(data, 'title', locale) as string;
const contentField = data[`content_${locale}`] as
  | (() => Promise<{ node: unknown }>)
  | { node: unknown }
  | null;
const contentHtml = await renderMarkdoc(contentField);
const image = data.image as { src?: string; alt_ca?: string; alt_es?: string } | null;
const imageAlt = image ? getLocalizedField(image as Record<string, string>, 'alt', locale) : '';
const sectionId = locale === 'ca' ? 'qui-som' : 'quienes-somos';
---

<section id={sectionId} class="bg-surface py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    {title && (
      <h2 class="mb-8 text-center font-display text-3xl font-bold text-primary sm:text-4xl">
        {title}
      </h2>
    )}
    <div class="grid items-center gap-10 lg:grid-cols-2">
      <div class="prose prose-lg max-w-none text-text-muted" set:html={contentHtml} />
      {image?.src && (
        <div>
          <OptimizedImage
            src={image.src}
            alt={imageAlt || ''}
            class="rounded-2xl object-cover shadow-md"
            loading="lazy"
            width={640}
            height={480}
            sizes="(max-width: 1024px) 100vw, 50vw"
          />
        </div>
      )}
    </div>
  </div>
</section>
