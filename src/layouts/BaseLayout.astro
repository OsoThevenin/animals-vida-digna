---
import '../styles/global.css';
import { getLocaleFromUrl, t, getAlternateUrl } from '../i18n/index';
import { buildCanonicalUrl, buildOgMeta, buildHreflangLinks, buildOrganizationSchema } from '../lib/seo';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DonateSticky from '../components/DonateSticky.tsx';
import ConstructionBanner from '../components/ConstructionBanner.astro';

interface Props {
  title: string;
  description?: string;
  donateUrl?: string;
  canonicalUrl?: string;
  ogImage?: string;
  alternateUrl?: string;
  jsonLd?: object;
}

const { title, description, donateUrl = '#', canonicalUrl, ogImage, alternateUrl, jsonLd } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const currentUrl = Astro.url.href;
const site = Astro.site?.href?.replace(/\/$/, '') || 'https://animalsvidadigna.org';
const resolvedCanonical = canonicalUrl || buildCanonicalUrl(Astro.url.pathname, site);
const resolvedAlternate = alternateUrl || buildCanonicalUrl(
  getAlternateUrl(Astro.url, locale === 'ca' ? 'es' : 'ca'),
  site,
);
const hreflangLinks = buildHreflangLinks(resolvedCanonical, resolvedAlternate, locale);
const ogMeta = description
  ? buildOgMeta({
      title,
      description,
      url: resolvedCanonical,
      locale,
      image: ogImage,
    })
  : null;
const orgSchema = buildOrganizationSchema({
  name: 'Animals Vida Digna',
  url: site,
  logo: new URL('/images/logo.webp', site).href,
});
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | {t(locale, 'common.siteName')}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/webp" href="/images/logo.webp" />
    <link rel="canonical" href={resolvedCanonical} />
    {hreflangLinks.map(link => (
      <link rel="alternate" hreflang={link.hreflang} href={link.href} />
    ))}
    {ogMeta && Object.entries(ogMeta).map(([property, content]) => (
      <meta property={property} content={content} />
    ))}
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="flex min-h-screen flex-col bg-surface font-sans text-text">
    <ConstructionBanner />
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-lg focus:bg-primary focus:px-4 focus:py-2 focus:text-surface focus:outline-none"
    >
      {t(locale, 'a11y.skipToContent')}
    </a>
    <Header locale={locale} currentUrl={currentUrl} donateUrl={donateUrl} />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} donateUrl={donateUrl} />
    {donateUrl !== '#' && (
      <DonateSticky client:idle url={donateUrl} text={t(locale, 'cta.donate')} />
    )}
  </body>
</html>
