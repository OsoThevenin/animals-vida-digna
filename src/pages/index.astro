---
import BaseLayout from '../layouts/BaseLayout.astro';
import { reader } from '../lib/keystatic';
import { getLocalizedField } from '../i18n/content';
import HeroSection from '../components/landing/HeroSection.astro';
import AboutSection from '../components/landing/AboutSection.astro';
import StatsSection from '../components/landing/StatsSection.astro';
import ColoniesSection from '../components/landing/ColoniesSection.astro';
import AdoptSection from '../components/landing/AdoptSection.astro';
import CollaborateSection from '../components/landing/CollaborateSection.astro';
import ContactCtaSection from '../components/landing/ContactCtaSection.astro';
import FeaturedCatsSection from '../components/landing/FeaturedCatsSection.astro';

const locale = 'ca' as const;

const settings = await reader.singletons.settings.read();
const landing = await reader.singletons.landing.read();

const donateUrl = settings?.donateUrl ?? '#';
const seoTitle = settings?.seo?.title_ca || 'Inici';
const seoDescription = settings?.seo?.description_ca || "Protectora d'animals a Catalunya";

const sections = landing?.sections ?? [];
---

<BaseLayout title={seoTitle} description={seoDescription} donateUrl={donateUrl}>
  {sections.map((section) => {
    switch (section.discriminant) {
      case 'hero':
        return <HeroSection data={section.value as Record<string, unknown>} locale={locale} donateUrl={donateUrl} />;
      case 'about':
        return <AboutSection data={section.value as Record<string, unknown>} locale={locale} />;
      case 'stats':
        return <StatsSection data={section.value as Record<string, unknown>} locale={locale} />;
      case 'colonies':
        return <ColoniesSection data={section.value as Record<string, unknown>} locale={locale} />;
      case 'adopt':
        return <AdoptSection data={section.value as Record<string, unknown>} locale={locale} />;
      case 'collaborate':
        return <CollaborateSection data={section.value as Record<string, unknown>} locale={locale} />;
      case 'contactCta':
        return <ContactCtaSection data={section.value as Record<string, unknown>} locale={locale} />;
      case 'newsletter':
        return <div class="py-8 text-center text-text-muted">{/* TODO: Newsletter section (v2) */}</div>;
      case 'faq':
        return <div class="py-8 text-center text-text-muted">{/* TODO: FAQ section (v2) */}</div>;
      default:
        return null;
    }
  })}
  <FeaturedCatsSection locale={locale} />
</BaseLayout>
