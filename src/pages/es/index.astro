---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Inicio" description="Protectora de animales en Catalunya">
  <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6 sm:py-24">
    <div class="text-center">
      <h1 class="font-display text-4xl font-bold text-primary sm:text-5xl">
        Bienvenidos a Animals Vida Digna
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-text-muted">
        Somos una protectora de animales dedicada a rescatar, cuidar y encontrar
        hogares amorosos para los gatos abandonados y maltratados de nuestra
        comunidad.
      </p>
      <div class="mt-8 flex justify-center gap-4">
        <a
          href="#gatos"
          class="rounded-lg bg-primary px-6 py-3 font-semibold text-surface transition-colors hover:bg-primary-dark"
        >
          Adoptame
        </a>
        <a
          href="#"
          class="rounded-lg border-2 border-accent bg-transparent px-6 py-3 font-semibold text-accent transition-colors hover:bg-accent hover:text-text"
        >
          Haz un donativo
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
