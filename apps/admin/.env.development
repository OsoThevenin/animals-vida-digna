# PUBLIC_ build-time variable, loaded automatically by Astro/Vite in dev.
# Points local `imageUrl()` calls at the dev-only `GET /r2/[...key]` route
# (apps/admin/src/pages/r2/[...key].ts) so uploaded photos preview locally
# without Cloudflare Images or a public R2 bucket. Production builds omit
# this file — imageUrl() then falls back to DEFAULT_IMAGES_ORIGIN from
# @avd/content/image-url.
PUBLIC_IMAGES_ORIGIN=http://localhost:4322/r2
