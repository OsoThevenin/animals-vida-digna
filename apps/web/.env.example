# Resend email delivery
RESEND_API_KEY=re_xxxxxxxxxxxx

# Keystatic GitHub-mode auth.
#
# In production these are Cloudflare Worker RUNTIME secrets, set with
# `wrangler secret put` -- Keystatic reads them from locals.runtime.env on each
# request. They are listed here only to document what the deployed Worker
# needs; local development uses `local` storage and needs none of them.
#
# See docs/keystatic-admin-setup.md.
KEYSTATIC_GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxx
KEYSTATIC_GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Any long random string; generate with: openssl rand -hex 32
KEYSTATIC_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
