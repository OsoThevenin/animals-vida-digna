---
import type { Locale } from '../../i18n/index';
import { getLocalizedField } from '../../i18n/content';

interface Props {
  data: Record<string, unknown>;
  locale: Locale;
}

const { data, locale } = Astro.props;

const title = getLocalizedField(data, 'title', locale) as string;
const items = (data.items as Array<Record<string, string>>) ?? [];
---

<section class="bg-primary/5 py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    {title && (
      <h2 class="mb-12 text-center font-display text-3xl font-bold text-primary sm:text-4xl">
        {title}
      </h2>
    )}
    <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:grid-cols-4">
      {items.map((item) => {
        const label = getLocalizedField(item, 'label', locale) as string;
        return (
          <div class="text-center">
            <p class="font-display text-4xl font-bold text-primary-dark sm:text-5xl">
              {item.value}
            </p>
            <p class="mt-2 text-sm font-medium text-text-muted sm:text-base">
              {label}
            </p>
          </div>
        );
      })}
    </div>
  </div>
</section>
