---
import type { Locale } from '../../i18n/index';
import { t } from '../../i18n/index';
import { getLocalizedField } from '../../i18n/content';

interface Props {
  data: Record<string, unknown>;
  locale: Locale;
}

const { data, locale } = Astro.props;

const title = getLocalizedField(data, 'title', locale) as string;
const subtitle = getLocalizedField(data, 'subtitle', locale) as string;
const catsHref = locale === 'ca' ? '/cats' : '/es/cats';
const sectionId = locale === 'ca' ? 'gats' : 'gatos';
---

<section id={sectionId} class="bg-accent/10 py-16 sm:py-24">
  <div class="mx-auto max-w-4xl px-4 text-center sm:px-6">
    {title && (
      <h2 class="font-display text-3xl font-bold text-primary sm:text-4xl">
        {title}
      </h2>
    )}
    {subtitle && (
      <p class="mx-auto mt-4 max-w-2xl text-lg text-text-muted">
        {subtitle}
      </p>
    )}
    <div class="mt-8">
      <a
        href={catsHref}
        class="inline-block rounded-lg bg-primary px-8 py-3 font-semibold text-surface transition-colors hover:bg-primary-dark"
      >
        {t(locale, 'cta.adopt')}
      </a>
    </div>
  </div>
</section>
