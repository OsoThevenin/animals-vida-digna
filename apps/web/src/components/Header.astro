---
import type { Locale } from '../i18n/index';
import { t } from '../i18n/index';
import LanguageSwitcher from './LanguageSwitcher.tsx';

interface Props {
  locale: Locale;
  currentUrl: string;
  donateUrl?: string;
  /**
   * The correct absolute alternate-locale URL for the current page, computed
   * by BaseLayout (per-cat slug_ca/slug_es for cat pages). Threaded through
   * to LanguageSwitcher, which otherwise falls back to a generic /es
   * path-prefix swap that is wrong whenever CA/ES slugs differ.
   */
  alternateUrl?: string;
}

const { locale, currentUrl, donateUrl = '#', alternateUrl } = Astro.props;

const navLinks = [
  { key: 'nav.about' as const, href: locale === 'ca' ? '/#qui-som' : '/es/#quienes-somos' },
  { key: 'nav.cats' as const, href: locale === 'ca' ? '/#gats' : '/es/#gatos' },
  { key: 'nav.colonies' as const, href: locale === 'ca' ? '/#colonies' : '/es/#colonias' },
  { key: 'nav.collaborate' as const, href: locale === 'ca' ? '/#colabora' : '/es/#colabora' },
  { key: 'nav.contact' as const, href: locale === 'ca' ? '/#contacte' : '/es/#contacto' },
];
---

<header class="sticky top-0 z-50 border-b border-primary/10 bg-surface/80 backdrop-blur-md">
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6">
    <!-- Logo -->
    <a
      href={locale === 'ca' ? '/' : '/es'}
      class="flex items-center gap-2"
      aria-label="Animals Vida Digna"
    >
      {/* alt="" (decorative): the link's aria-label already names the
          destination, and the visible span (on sm+ viewports) repeats it --
          an img alt duplicating the adjacent visible text triggers axe's
          image-redundant-alt rule. */}
      <img
        src="/images/logo.webp"
        alt=""
        class="h-10 w-auto"
        width="40"
        height="40"
      />
      <span
        class="hidden font-display text-lg font-bold text-primary sm:inline"
        aria-hidden="true"
      >
        Animals Vida Digna
      </span>
    </a>

    <!-- Desktop Navigation -->
    <ul class="hidden items-center gap-6 md:flex">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="text-sm font-medium text-text-muted transition-colors hover:text-primary"
          >
            {t(locale, link.key)}
          </a>
        </li>
      ))}
    </ul>

    <!-- Actions -->
    <div class="flex items-center gap-3">
      <a
        href={donateUrl}
        target={donateUrl.startsWith('http') ? '_blank' : undefined}
        rel={donateUrl.startsWith('http') ? 'noopener noreferrer' : undefined}
        class="rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-text transition-colors hover:bg-accent-light"
      >
        {t(locale, 'cta.donate')}
      </a>
      <LanguageSwitcher
        client:load
        currentUrl={currentUrl}
        currentLocale={locale}
        alternateUrl={alternateUrl}
      />
      <!-- Mobile menu button -->
      <button
        type="button"
        class="inline-flex items-center justify-center rounded-lg p-2 text-text-muted transition-colors hover:text-primary md:hidden"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        id="mobile-menu-btn"
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Navigation -->
  <div id="mobile-menu" class="border-t border-primary/10 md:hidden" hidden aria-hidden="true">
    <ul class="space-y-1 px-4 py-3">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="block rounded-lg px-3 py-2 text-sm font-medium text-text-muted transition-colors hover:bg-primary/5 hover:text-primary"
          >
            {t(locale, link.key)}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      menu.setAttribute('aria-hidden', String(isExpanded));
      if (isExpanded) {
        menu.setAttribute('hidden', '');
      } else {
        menu.removeAttribute('hidden');
      }
    });
  }
</script>
