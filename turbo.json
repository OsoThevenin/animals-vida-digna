{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["PUBLIC_*", "RESEND_API_KEY"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build", "build"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "check": {}
  }
}
